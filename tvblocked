#!/usr/bin/env python3
"""tvblocked -- total telemetry blocked, with per-target breakdown.

Joins tvsniff's event log against the live rules:
  - DNS sinkhole intercepts: lookups the TV made for blocked domains
  - IP blackhole drops:      connection attempts to blocked IPs
  - MQTT IoT attempts:       tcp/8883 (port-blocked regardless of dst)
  - LAN probes:              live nft counter (resets on ruleset reload)
"""
import json
import re
import subprocess
import sys
import time
from collections import Counter

FLOWS = "/var/lib/tvsniff/flows.jsonl"
BLOCKLIST = "/etc/dnsmasq.d/tv-blocklist.conf"
IP_RE = re.compile(r"\b\d{1,3}(?:\.\d{1,3}){3}\b")


def load_domains():
    doms = []
    try:
        with open(BLOCKLIST) as fh:
            for line in fh:
                m = re.match(r"\s*address=/([^/]+)/", line)
                if m:
                    doms.append(m.group(1).lower().strip("."))
    except OSError:
        pass
    return doms


def load_ips():
    try:
        out = subprocess.run(
            ["nft", "list", "set", "inet", "tvrelay", "blocked_v4"],
            capture_output=True, text=True, check=True).stdout
    except Exception:
        return None
    return set(IP_RE.findall(out.split("elements", 1)[-1]))


def matches_domain(name, domains):
    for d in domains:
        if name == d or name.endswith("." + d):
            return d
    return None


def main():
    domains = load_domains()
    ips = load_ips()
    dns_hits = Counter()
    ip_hits = Counter()
    mqtt = 0
    first_ts = last_ts = None

    with open(FLOWS) as fh:
        for line in fh:
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            t = ev.get("ts")
            if t:
                first_ts = t if first_ts is None else min(first_ts, t)
                last_ts = t if last_ts is None else max(last_ts, t)
            et = ev.get("type")
            if et == "dns_q":
                for name in ev.get("names", []):
                    d = matches_domain(name.lower().strip("."), domains)
                    if d:
                        dns_hits[d] += 1
            elif et == "conn":
                dst = ev.get("dst", "")
                if ev.get("proto") == "tcp" and ev.get("dport") == 8883:
                    mqtt += 1
                if ips and dst in ips:
                    ip_hits[dst] += 1

    total_dns = sum(dns_hits.values())
    total_ip = sum(ip_hits.values())
    total = total_dns + total_ip + mqtt

    def span():
        if not first_ts:
            return "no data"
        fmt = lambda x: time.strftime("%Y-%m-%d %H:%M", time.localtime(x))
        return "%s -> %s" % (fmt(first_ts), fmt(last_ts))

    print("=" * 62)
    print("  TELEMETRY BLOCKED   (log window: %s)" % span())
    print("=" * 62)
    print("DNS sinkhole intercepts ............ %d lookups" % total_dns)
    for d, n in dns_hits.most_common(10):
        print("   %-38s %5d" % (d[:38], n))
    print()
    print("IP blackhole connection attempts ... %d" % total_ip)
    for ip, n in ip_hits.most_common(10):
        print("   %-38s %5d" % (ip, n))
    print()
    print("AWS IoT MQTT (tcp/8883) attempts .. %d" % mqtt)
    try:
        out = subprocess.run(
            ["nft", "list", "chain", "inet", "tvrelay", "forward"],
            capture_output=True, text=True, check=True).stdout
        m = re.search(r"tv lan probe.*?counter packets (\d+)", out)
        if m:
            print("LAN ICMP probes (since reload) .... %s packets" % m.group(1))
    except Exception:
        pass
    print("-" * 62)
    print("TOTAL BLOCKED ATTEMPTS ............. %d" % total)


if __name__ == "__main__":
    main()
