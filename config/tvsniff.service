[Unit]
Description=TV relay endpoint sniffer (tvsniff)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tvsniff --iface enP4p65s0 --lan 192.168.2.0/24 --log /var/lib/tvsniff/flows.jsonl
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=tvsniff

[Install]
WantedBy=multi-user.target
